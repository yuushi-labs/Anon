# 環境変数設定例
# このファイルをコピーして .env.local として利用してください。
# 例: cp .env.example .env.local

# MySQLデータベース接続文字列 (必須)
# 例: mysql://user:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/dbname

# JWT署名・Cookie関連の秘密鍵 (必須)
# 本番環境では十分に長く、予測困難なランダムな文字列を使用してください。
JWT_SECRET="your-jwt-secret-here"

# クライアントから接続するAPIサーバーのベースURL (推奨)
# 開発環境では通常、APIサーバーのローカルアドレスを指定します。
# 例: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL="http://192.0.2.10:3000"

# APIサーバーのポート (任意)
# 指定しない場合、デフォルトは3000です。
PORT="3000"

# Node.js環境 (任意)
# development または production
NODE_ENV="development"

# 以下はテンプレート由来のOAuth機能を使用する場合に設定します。
# Anonアプリでは直接使用されない可能性がありますが、
# テンプレートの機能が残っているため記載しています。

# OAuthポータルURL
# EXPO_PUBLIC_OAUTH_PORTAL_URL=""

# OAuthサーバーURL
# EXPO_PUBLIC_OAUTH_SERVER_URL=""

# アプリケーションID
# EXPO_PUBLIC_APP_ID=""

# オーナーのOpen ID
# EXPO_PUBLIC_OWNER_OPEN_ID=""

# オーナー名
# EXPO_PUBLIC_OWNER_NAME=""

# 組み込みForge API URL
# BUILT_IN_FORGE_API_URL=""

# 組み込みForge APIキー
# BUILT_IN_FORGE_API_KEY=""
